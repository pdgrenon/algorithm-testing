node_modules/
.DS_Store
*.log

# Screenshots are regenerated by `npm run shots` from the frozen fixtures, so
# they are reproducible rather than worth committing. CI uploads them as an
# artifact on every run.
shots/

# The Python reference implementation's on-disk response cache. Never
# committed: it is a copy of somebody else's data with a timestamp on it, and
# fixtures/weeks/ is the version that is meant to be reproducible.
survivor-picker/cache/*
!survivor-picker/cache/.gitkeep
__pycache__/
*.pyc
.pytest_cache/
