node_modules/
.DS_Store
*.log

__pycache__/
*.pyc
.pytest_cache/

# The ESPN response cache. Never committed: it is a copy of somebody else's
# data with a timestamp on it, and fixtures/weeks/ is the version that is
# meant to be reproducible.
cache/*.json
!cache/.gitkeep

# generate_report.py's output. It used to be published to GitHub Pages by a
# scheduled workflow; that workflow is gone and the app replaces it, so this is
# a local artifact now. Still ignored, because a generated file in the tree is
# a generated file in the tree.
report.html

# The old output location, kept ignored so a stale checkout does not suddenly
# start offering to commit one.
docs/

# Screenshots are regenerated by `npm run shots` from the frozen fixtures, so
# they are reproducible rather than worth committing. CI uploads them as an
# artifact on every run.
shots/
